{
  "name": "@dotbrains/agnt",
  "version": "0.1.0",
  "description": "Local bridge between coding-agent CLIs (Codex, Claude Code, opencode, Cursor, ...) and the Agnt mobile app. Run `agnt up` to start.",
  "main": "src/index.js",
  "bin": {
    "agnt": "./bin/agnt.js",
    "agnt-jsonl-diagnose": "./bin/agnt-jsonl-diagnose.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "ci": "bun run test",
    "start": "node ./bin/agnt.js up",
    "test": "node --test",
    "postinstall": "node ./src/bootstrap-provider.js",
    "prepack": "node ./scripts/prepare-private-defaults.js",
    "postpack": "node ./scripts/cleanup-private-defaults.js"
  },
  "keywords": [
    "agnt",
    "agent",
    "bridge",
    "cli",
    "codex",
    "claude-code",
    "opencode",
    "cursor",
    "multi-provider"
  ],
  "author": "dotbrains",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "dependencies": {
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "node-gyp": "12.1.0"
  }
}
